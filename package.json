{
  "name": "herceg-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "benchmarks"
  ],
  "scripts": {
    "typecheck": "tsc -p benchmarks",
    "lint": "biome check .",
    "format": "biome check --write .",
    "bench": "npm run bench -w herceg-benchmarks --",
    "bench:size": "npm run size -w herceg-benchmarks --",
    "bench:report": "npm run report -w herceg-benchmarks"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
