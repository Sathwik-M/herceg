{
  "name": "herceg",
  "version": "0.0.0",
  "description": "Framework-independent charting engine with columnar data, streaming updates, and SVG/Canvas rendering.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/from-spec.d.ts",
      "import": "./dist/from-spec.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "node --experimental-strip-types bench/core.ts"
  },
  "devDependencies": {
    "axe-core": "^4.14.0"
  }
}
