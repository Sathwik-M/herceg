exports[`renderToSVG > renders a deterministic line chart 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="480" height="240" viewBox="0 0 480 240" role="img" aria-labelledby="latency-title latency-desc" font-family="ui-sans-serif, system-ui, -apple-system, &#34;Segoe UI&#34;, Roboto, &#34;Helvetica Neue&#34;, Arial, sans-serif" font-size="12" fill="#5d6677"><title id="latency-title">Latency</title><desc id="latency-desc">API and database latency. Line chart with 2 series. api: 12 points, from 120 to 190, last 186. db: 12 points, from 80 to 110, last 108. Rule: SLO (y 150).</desc><defs><clipPath id="latency-clip-0"><rect x="60" y="53" width="408" height="159"/></clipPath></defs><rect width="480" height="240" fill="#ffffff"/><path d="M60 212.5H468M60 186.5H468M60 159.5H468M60 133.5H468M60 106.5H468M60 80.5H468M60 53.5H468" stroke="#e8ebf0" fill="none"/><g clip-path="url(#latency-clip-0)"><path d="M60 159L97.1 139.1L134.2 148.4L171.3 119.3L208.4 103.3L245.5 108.7L282.5 91.4L319.6 98.1L356.7 79.5L393.8 86.1L430.9 66.3L468 71.6" fill="none" stroke="#3266d6" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/><path d="M60 212L97.1 209.4M171.3 198.8L208.4 192.1L245.5 196.1L282.5 186.8L319.6 184.2L356.7 188.1L393.8 178.9L430.9 172.3L468 174.9" fill="none" stroke="#ec6a2c" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/></g><line x1="60" y1="119.3" x2="468" y2="119.3" stroke="#5d6677" stroke-width="1" stroke-dasharray="4 4"/><text x="464" y="115.3" text-anchor="end" fill="#5d6677">SLO</text><g style="font-variant-numeric:tabular-nums"><path d="M60 212.5H468M60.5 212.5V217.5M171.5 212.5V217.5M283.5 212.5V217.5M394.5 212.5V217.5" stroke="#cfd5de" fill="none"/><text x="60" y="220.5" text-anchor="middle" dominant-baseline="hanging">08:00</text><text x="171.3" y="220.5" text-anchor="middle" dominant-baseline="hanging">08:15</text><text x="282.5" y="220.5" text-anchor="middle" dominant-baseline="hanging">08:30</text><text x="393.8" y="220.5" text-anchor="middle" dominant-baseline="hanging">08:45</text><text x="52" y="212" text-anchor="end" dominant-baseline="middle">80</text><text x="52" y="185.5" text-anchor="end" dominant-baseline="middle">100</text><text x="52" y="159" text-anchor="end" dominant-baseline="middle">120</text><text x="52" y="132.5" text-anchor="end" dominant-baseline="middle">140</text><text x="52" y="106" text-anchor="end" dominant-baseline="middle">160</text><text x="52" y="79.5" text-anchor="end" dominant-baseline="middle">180</text><text x="52" y="53" text-anchor="end" dominant-baseline="middle">200</text><text x="9.5" y="132.5" text-anchor="middle" dominant-baseline="middle" fill="#1c2333" transform="rotate(-90 9.5 132.5)">ms</text></g><text x="8" y="14" dominant-baseline="middle" font-size="15" font-weight="600" fill="#1c2333">Latency</text><rect x="8" y="25" width="10" height="10" rx="2" fill="#3266d6"/><text x="24" y="30" dominant-baseline="middle" fill="#1c2333">api</text><rect x="57.6" y="25" width="10" height="10" rx="2" fill="#ec6a2c"/><text x="73.6" y="30" dominant-baseline="middle" fill="#1c2333">db</text></svg>"`;

