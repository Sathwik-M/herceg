{
  "name": "@herceg/svelte",
  "version": "0.0.0",
  "description": "Svelte components for herceg charts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/op55-org/herceg.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/op55-org/herceg/tree/main/packages/svelte#readme",
  "bugs": "https://github.com/op55-org/herceg/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-publish.mjs",
    "build": "svelte-package --input src --output dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "herceg": "0.0.0"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "devDependencies": {
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "charts",
    "visualization",
    "typescript",
    "svelte"
  ]
}
