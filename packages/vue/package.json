{
  "name": "@herceg/vue",
  "version": "0.0.0",
  "description": "Vue components for herceg charts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/op55-org/herceg.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/op55-org/herceg/tree/main/packages/vue#readme",
  "bugs": "https://github.com/op55-org/herceg/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./guides": {
      "types": "./dist/guides.d.ts",
      "import": "./dist/guides.js",
      "default": "./dist/guides.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepublishOnly": "node ../../scripts/check-publish.mjs",
    "build": "tsc -p tsconfig.build.json",
    "test:browser": "vitest run"
  },
  "dependencies": {
    "herceg": "0.0.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "3.5.43"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "charts",
    "visualization",
    "typescript",
    "vue"
  ]
}
